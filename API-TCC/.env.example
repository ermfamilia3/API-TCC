# Copie este arquivo para .env e preencha com os dados do seu ambiente.
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=teste_api

# Gere uma chave nova e secreta. Não publique nem compartilhe o arquivo .env.
SECRET_KEY=gere_uma_chave_secreta_longa_aqui

# Origens autorizadas do frontend (separe por vírgula).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
